{
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -A -p -i run dev",
    "dev:web": "yarn workspace web dev",
    "dev:api": "yarn workspace api dev",
    "build": "yarn workspace web build && yarn workspace api build",
    "start": "node --env-file=apps/api/.env apps/api/dist/main.js",
    "deploy:mark": "node scripts/mark-manual-deploy.mjs",
    "check:nex-table": "node scripts/check-nex-table.mjs",
    "check:nex-css": "node scripts/check-nex-css.mjs",
    "check:nex-screens": "node scripts/compare-nex-screens.mjs",
    "check:work-log": "node scripts/check-work-log.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
