  .nexhb {
    /* ★폴백 히어로(관리자 배너 미업로드 시에만 노출)도 운영사 테마를 따르게 — 표면/글자/강조 전부 토큰 참조.
       다크 기본 테마에선 원본 hex와 채널당 오차 \xb13 수준(육안 동일), 라이트 테마에선 표면이 밝아지고 글자가 어두워진다.
       (빨강 rgba(255,71,71,…)\xb7보라 rgba(139,92,246,…) 등 토큰과 무관한 장식색과 슬라이드3 룰렛/칩 '오브젝트'는 다크 고정 유지.) */
    --green: var(--color-accent, #22e07a);
    --green-deep: var(--color-accent-strong, #16c964);
    --gold: var(--color-gold, #ffb80c);
    --on-accent: var(--color-on-accent, #04130a);
    --bg: var(--color-bg, #131517);
    --panel: var(--color-panel, #191c1f);
    --input: var(--color-input, #101214);
    --fg: var(--color-fg, #f2f4f6);
    --dim: var(--color-dim, #9aa3ad);
    --muted: var(--color-muted, #666f79);
    --info: var(--color-info, #3b82f6);
    /* 밝은 강조 글자(#5dffa3/#ffd27a 대체): 다크에선 밝은 accent/gold, 라이트에선 fg 쪽으로 어두워져 가독 유지 */
    --green-bright: color-mix(in srgb, var(--green) 72%, var(--fg) 28%);
    --gold-bright: color-mix(in srgb, var(--gold) 52%, var(--fg) 48%);
    --design-w: 1240;          /* 디자인 기준 폭(px, 단위 없이) */
    --design-h: 360;           /* 디자인 기준 높이(px, 단위 없이) */
    --radius: var(--radius-modal, 16px); /* 테마 둥글기 옵션 연동(기본 16px 불변) - 실배너(HeroBanner rounded-modal)와 동일 대우 */
    --interval: 4200ms;        /* 참고용(JS에서 data-interval 사용) */
    font-family: inherit;
  }

  /* ---------- 반응형 뷰포트(겉 박스) ---------- */
  .nexhb__viewport {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    aspect-ratio: 1240 / 360;  /* 비율 고정 → 높이 자동 */
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg);
    -webkit-user-select: none; user-select: none;
  }

  /* ---------- 스케일러: 1240\xd7360 고정 디자인을 통째로 축소 ---------- */
  .nexhb__scaler {
    position: absolute;
    top: 0; left: 0;
    width: 1240px;
    height: 360px;
    transform-origin: top left;
    /* transform: scale(...) 는 JS가 뷰포트 폭에 맞춰 설정 */
  }

  /* ---------- 트랙 ---------- */
  .nexhb__track {
    display: flex;
    width: 3720px;             /* 1240 \xd7 슬라이드 수(3) */
    height: 360px;
    transition: transform 0.7s cubic-bezier(0.65, 0.02, 0.2, 1);
    will-change: transform;
  }
  .nexhb__slide {
    position: relative;
    width: 1240px;
    height: 360px;
    flex: 0 0 1240px;
    overflow: hidden;
  }
  .nexhb__bggrid { position: absolute; inset: 0; }
  .nexhb__inner {
    position: relative; z-index: 1; height: 100%;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 92px;          /* 좌우 안전영역 */
  }
  .nexhb__copy { display: flex; flex-direction: column; gap: 17px; max-width: 620px; }
  .nexhb__eyebrow { font-size: 15px; font-weight: 600; letter-spacing: 0.14em; }
  .nexhb__title { margin: 0; font-weight: 900; letter-spacing: -0.025em; }
  .nexhb__desc { margin: 0; font-size: 17px; line-height: 1.5; color: color-mix(in srgb, var(--dim) 79%, var(--fg) 21%); white-space: nowrap; }
  .nexhb__desc b { color: var(--fg); font-weight: 700; }
  .nexhb__ctarow { display: flex; align-items: center; gap: 15px; margin-top: 5px; }
  .nexhb__cta {
    padding: 14px 28px; border-radius: var(--radius-card, 12px); /* 테마 둥글기 옵션 연동(기본 12px 불변) */
    background: linear-gradient(160deg, var(--green), var(--green-deep));
    color: var(--on-accent); font-weight: 800; font-size: 16px; text-decoration: none;
    box-shadow: 0 8px 22px color-mix(in srgb, var(--green) 40%, transparent); white-space: nowrap;
  }
  .nexhb__note { color: color-mix(in srgb, var(--dim) 50%, var(--muted) 50%); font-size: 14px; white-space: nowrap; }
  .nexhb__logo { display: flex; align-items: center; gap: 12px; }
  .nexhb__mark {
    width: 38px; height: 38px; border-radius: 10px;
    background: linear-gradient(160deg, var(--green), var(--green-deep));
    display: flex; align-items: flex-end; justify-content: center; gap: 3px; padding-bottom: 9px;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--green) 50%, transparent);
  }
  .nexhb__mark i { width: 4px; border-radius: 2px; background: color-mix(in srgb, var(--on-accent) 62%, #000 38%); display: block; }
  .nexhb__brand { font-weight: 800; font-size: 18px; letter-spacing: -0.01em; color: var(--fg); }
  .nexhb__badge {
    padding: 4px 12px; border-radius: 999px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em;
    border: 1px solid color-mix(in srgb, var(--green) 45%, transparent); color: var(--green-bright);
  }
  .nexhb__pill {
    display: inline-flex; align-items: center; gap: 8px; align-self: flex-start;
    padding: 6px 14px; border-radius: 999px; font-size: 12.5px; font-weight: 700;
    letter-spacing: 0.06em; white-space: nowrap;
  }
  .nexhb__dot-live { width: 7px; height: 7px; border-radius: 50%; animation: nexhb-pulse 1.4s ease-in-out infinite; }
  .nexhb__art { position: relative; flex-shrink: 0; }

  /* ---------- 점 인디케이터 ---------- */
  .nexhb__dots {
    position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 8px; z-index: 5;
  }
  .nexhb__dots button {
    width: 7px; height: 7px; padding: 0; border: none; border-radius: 4px;
    background: color-mix(in srgb, var(--fg) 35%, transparent); cursor: pointer;
    transition: width 0.4s ease, background 0.4s ease;
  }
  .nexhb__dots button[aria-current="true"] { width: 26px; background: var(--green); }

  /* ---------- 좌우 화살표 ---------- */
  .nexhb__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 40px; height: 40px; border-radius: 50%; border: none; z-index: 5;
    background: rgba(10, 14, 16, 0.5); color: #fff; font-size: 20px; line-height: 1;
    cursor: pointer; backdrop-filter: blur(4px); transition: background 0.2s ease;
    display: flex; align-items: center; justify-content: center;
  }
  .nexhb__arrow:hover { background: rgba(10, 14, 16, 0.8); }
  .nexhb__arrow--prev { left: 16px; }
  .nexhb__arrow--next { right: 16px; }

  @keyframes nexhb-pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.35; transform:scale(.7); } }
  @keyframes nexhb-floatA { 0%,100% { transform:translateY(0) rotate(-4deg); } 50% { transform:translateY(-9px) rotate(-4deg); } }
  @keyframes nexhb-floatB { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-8px); } }
  @keyframes nexhb-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .nexhb__track { transition: none; }
    .nexhb [style*="animation"] { animation: none !important; }
  }

