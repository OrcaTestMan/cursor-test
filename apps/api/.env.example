DATABASE_URL=postgresql://nex:nex@localhost:5432/nex
PORT=3000
WEB_ORIGIN=http://localhost:5173
# HTTPS 적용 후 세션 쿠키 Secure 를 켜려면 1
# AUTH_COOKIE_SECURE=1
# 관리자 로그인 5회 실패 → 15분 잠금. 1이면 켜짐, 없거나 0이면 잠금 없음
# ADMIN_LOGIN_LOCKOUT=1
# TRUST_PROXY=1
# WEB_DIST=apps/web/dist
# 텔레그램 알림. 둘 다 비어 있으면 로그만 남기고 에러 없이 넘어간다.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# 관리자 CLI 비밀 파일 위치. 비우면 C:\nex\secrets
# ADMIN_SECRETS_DIR=C:\nex\secrets
