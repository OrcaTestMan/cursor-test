DATABASE_URL=postgresql://nex:nex@localhost:5432/nex
PORT=3000
WEB_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# NODE_ENV=production 이면 ADMIN_PASSWORD를 10자 이상으로 둔다.
# 1단계 임시 HTTP Basic 인증. 운영에서는 둘 다 필수. 비우면 개발에서는 인증을 건너뛴다.
# TEMP_BASIC_AUTH_USER=
# TEMP_BASIC_AUTH_PASS=
# TRUST_PROXY=1
# WEB_DIST=apps/web/dist
# 텔레그램 알림. 둘 다 비어 있으면 로그만 남기고 에러 없이 넘어간다.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
