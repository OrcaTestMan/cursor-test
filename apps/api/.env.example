DATABASE_URL=postgresql://app:app@localhost:5432/app
PORT=3000
WEB_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# NODE_ENV=production 이면 ADMIN_PASSWORD를 10자 이상으로 두어야 한다.
# TRUST_PROXY=1 프록시 뒤에서 클라이언트 IP를 신뢰한다.
# WEB_DIST 화면 빌드 폴더. 비우면 apps/web/dist 를 찾는다.
# UPLOAD_DIR 업로드 저장 폴더. 비우면 apps/api/uploads 를 쓴다.
